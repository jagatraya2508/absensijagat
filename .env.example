# ========================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env pada server: cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. PORT SERVER & DOCKER (Mengikuti pola server anda)
# --------------------------------------------------------
# Port Nginx Frontend di host (Mengikuti pola 31080 -> 31081)
FRONTEND_PORT=31081

# Port API Backend Node.js di host (Mengikuti pola 5000 -> 5001)
PORT=5001

# Port PostgreSQL di host (Mengikuti urutan 5432, 5433, 5434 -> 5435)
DB_PORT=5435

# --------------------------------------------------------
# 2. DATABASE POSTGRESQL CONFIG
# --------------------------------------------------------
DB_NAME=absensi
DB_USER=postgres
DB_PASSWORD=PasswordAbsensiSuperAman123!

# --------------------------------------------------------
# 3. BACKEND SECURITY
# --------------------------------------------------------
JWT_SECRET=RahasiaSuperAmanAbsensiGudang2026!Key

# --------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (OPSIONAL)
# --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.absensigudang@gmail.com
SMTP_PASS=app_password_gmail_anda
SMTP_SECURE=false

# --------------------------------------------------------
# 5. FRONTEND & DOMAIN CONFIGURATION
# --------------------------------------------------------
DOMAIN=absensigudang.sahabatjayasukses.com
VITE_HMR_HOST=absensigudang.sahabatjayasukses.com
FRONTEND_ALLOWED_HOSTS=absensigudang.sahabatjayasukses.com,localhost
VITE_API_URL=/api
