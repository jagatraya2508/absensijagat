# ========================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env pada server: cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. PORT SERVER & DOCKER (Host Machine)
# --------------------------------------------------------
# Port Nginx di server host (diarahkan oleh Reverse Proxy luar)
FRONTEND_PORT=80

# Port API Backend Node.js di server host
PORT=5000

# Port PostgreSQL di server host (mencegah bentrok jika host punya postgres lokal)
DB_PORT=5433

# --------------------------------------------------------
# 2. DATABASE POSTGRESQL CONFIG
# --------------------------------------------------------
DB_NAME=absensi
DB_USER=postgres
DB_PASSWORD=PasswordAbsensiSuperAman123!
# DB_HOST otomatis di-set ke 'db' oleh docker-compose.yml

# --------------------------------------------------------
# 3. BACKEND SECURITY
# --------------------------------------------------------
JWT_SECRET=RahasiaSuperAmanAbsensiGudang2026!Key

# --------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (OPSIONAL - Notifikasi Email)
# --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.absensigudang@gmail.com
SMTP_PASS=app_password_gmail_anda
SMTP_SECURE=false

# --------------------------------------------------------
# 5. FRONTEND & DOMAIN CONFIGURATION
# --------------------------------------------------------
DOMAIN=absensigudang.sahabatjayasukses.com
VITE_HMR_HOST=absensigudang.sahabatjayasukses.com
FRONTEND_ALLOWED_HOSTS=absensigudang.sahabatjayasukses.com,localhost

# Endpoint API bawaan untuk frontend (Nginx memproksi /api ke backend)
VITE_API_URL=/api
