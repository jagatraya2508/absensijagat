# ========================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env pada server: cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. PORT SERVER & DOCKER (Opsi B)
# --------------------------------------------------------
# Port Nginx Frontend di host (diarahkan dari Reverse Proxy luar)
FRONTEND_PORT=3010

# Port API Backend Node.js di host
PORT=5001

# Port PostgreSQL di host
DB_PORT=5435

# --------------------------------------------------------
# 2. DATABASE POSTGRESQL CONFIG
# --------------------------------------------------------
DB_NAME=absensi
DB_USER=postgres
DB_PASSWORD=PasswordAbsensiSuperAman123!

# --------------------------------------------------------
# 3. BACKEND SECURITY
# --------------------------------------------------------
JWT_SECRET=RahasiaSuperAmanAbsensiGudang2026!Key

# --------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (OPSIONAL)
# --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.absensigudang@gmail.com
SMTP_PASS=app_password_gmail_anda
SMTP_SECURE=false

# --------------------------------------------------------
# 5. FRONTEND & DOMAIN CONFIGURATION
# --------------------------------------------------------
# Gudang: absensigudang.sahabatjayasukses.com (Docker, GitHub Actions runner absensigudang)
# Jagat:  absensi.jagatrayasolusindo.com (PM2, SSH deploy)
# Tiap server punya .env sendiri. Jangan samakan DB/JWT antar server.
DOMAIN=absensigudang.sahabatjayasukses.com
VITE_HMR_HOST=absensigudang.sahabatjayasukses.com
FRONTEND_ALLOWED_HOSTS=absensigudang.sahabatjayasukses.com,absensi.jagatrayasolusindo.com,localhost
VITE_API_URL=/api
